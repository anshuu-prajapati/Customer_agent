            },
            {
              "condition": "contains_hydraulic_keywords", 
              "next_node": "hydraulic_branch",
              "confidence": 0.82
            },
            {
              "condition": "contains_electrical_keywords",
              "next_node": "electrical_branch", 
              "confidence": 0.88
            },
            {
              "condition": "low_confidence",
              "next_node": "generic_questioning",
              "confidence": 0.60
            }
          ]
        },
        {
          "node_id": "engine_branch",
          "question": "इंजन स्टार्ट करने पर कोई आवाज आती है?",
