  "conversation_shortcuts": [
    {
      "id": "shortcut_001",
      "shortcut_name": "Repeat Customer Fast Track",
      "trigger_conditions": [
        "customer_phone_recognized",
        "machine_number_in_history",
        "high_confidence_problem_match"
      ],
      "optimizations": {
        "skip_steps": ["machine_validation", "customer_verification", "basic_information"],
        "direct_to": "problem_specific_flow",
        "token_reduction": 0.80,
        "time_reduction": "60%"
      },
      "flow": [
        "greeting_with_recognition",
        "problem_confirmation", 
        "direct_solution_path",
        "completion"
      ]
    },
    {
      "id": "shortcut_002", 
      "shortcut_name": "Critical Issue Fast Track",
      "trigger_conditions": [
        "safety_critical_keywords",
        "high_urgency_indicators",
        "brake_failure_detected"
      ],
      "optimizations": {
        "skip_steps": ["detailed_questioning", "non_critical_verification"],
        "direct_to": "emergency_specialist",
        "priority": "highest",
        "time_reduction": "70%"
      },
      "flow": [
        "safety_acknowledgment",
        "immediate_specialist_connection",
        "emergency_protocol"
      ]
    },
    {
      "id": "shortcut_003",
      "shortcut_name": "Routine Service Fast Track", 
      "trigger_conditions": [
        "oil_change_keywords",
        "routine_maintenance_indicators",
        "scheduled_service_pattern"
      ],
      "optimizations": {
        "skip_steps": ["detailed_problem_analysis", "diagnostic_questions"],
        "direct_to": "service_scheduling",
        "token_reduction": 0.75,
        "time_reduction": "50%"
      },
      "flow": [
        "service_type_confirmation",
        "scheduling_optimization",
        "completion"
      ]
    }
  ],
