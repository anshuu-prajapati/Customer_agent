            "estimated_resolution": "6.5_hours"
          },
          "branches": [
            {
              "condition": "ऊपर से",
              "next_node": "hydraulic_cylinder_check",
              "specialist": "hydraulic_repair"
            },
            {
              "condition": "नीचे से",
